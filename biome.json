{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "files": {
    "includes": [
      "**",
      "etl/**",
      "test/**",
      "contracts/**",
      "app/src/**",
      "app/test/**",
      "*.json",
      "!app/src/theme.css",
      "!app/dist",
      "!.claude",
      "!contracts/fixtures/static",
      "!infra/.pulumi"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "!**/*.css",
        "etl/lib/log.ts",
        "contracts/fixtures/generate.ts",
        "infra/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
